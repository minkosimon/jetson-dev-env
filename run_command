#!/usr/bin/env python3
"""Command launcher for board-related workflows.

Usage examples:
  ./run_command --board jetson-orin-nano --download 7.2
  ./run_command --board jetson-orin-nano --display-conf 7.2
  ./run_command --board jetson-orin-nano --list-jetpack-available
  ./run_command --board jetson-orin-nano --setup-jetpack-env 7.2
"""

from common.mbda_icon import MBDA_ICON
from common.common_function import is_valid_board, getEnvVariable, log_fatal
from common.liste_command import COMMANDS

import argparse
import os
import sys
from pathlib import Path
from common.config_env import export_to_environ


REPO_ROOT = Path(__file__).resolve().parent


def main(argv: list[str] | None = None) -> int:
	# Export project environment variables before parsing commands.
	export_to_environ(overwrite=True)

	parser = argparse.ArgumentParser(
		prog="run_command",
		description="Launch project commands with mandatory board selection.",
	)
	# board argument is required to specify the target board for the command execution.
	parser.add_argument("--board", required=True, help="Board name (example: jetson-orin-nano).")

	# option parsers for download, display-conf and list-jetpack-available actions.
	parser.add_argument("--download", dest="download_version", help="JetPack version to download (example: 7.2).")
	parser.add_argument("--display-conf", dest="display_conf_version", help="JetPack version whose configuration should be displayed (example: 7.2).")
	parser.add_argument(
		"--list-jetpack-available",
		dest="list_jetpack_available",
		action="store_true",
		help="List the JetPack versions available for the selected board.",
	)
	parser.add_argument(
		"--setup-jetpack-env",
		dest="setup_jetpack_env_version",
		help="Download, verify and compile the JetPack environment for the given version (example: 7.2).",
	)
	args = parser.parse_args(argv)

	# Validate the board argument and prepare the environment for command execution.
	if not is_valid_board(args.board):
		log_fatal(f"Error: Unknown board '{args.board}'. check if name of board folder is correct: {getEnvVariable('PROJECT_DIR_BOARDS')}/{args.board}")
		os._exit(1)

	if (
		args.download_version is None
		and args.display_conf_version is None
		and not args.list_jetpack_available
		and args.setup_jetpack_env_version is None
	):
		log_fatal("At least one action is required: --download, --display-conf, --list-jetpack-available or --setup-jetpack-env")
		os._exit(1)

	try:
		if args.download_version:
			COMMANDS.run("download_jetpack", args.download_version, board=args.board)

		if args.setup_jetpack_env_version:
			COMMANDS.run("setup_jetpack_environment", args.setup_jetpack_env_version, board=args.board)

		if args.display_conf_version:
			config = COMMANDS.run("get_config_jetpack", args.display_conf_version, board=args.board)
			print(f"Configuration JetPack {args.display_conf_version} pour {args.board} :")
			for key, value in config.items():
				print(f"  {key}: {value}")

		if args.list_jetpack_available:
			versions = COMMANDS.run("list_available_jetpack_versions", board=args.board)
			print(f"Versions JetPack disponibles pour {args.board} :")
			for version in versions:
				print(f"  - {version}")
	except Exception as exc:
		print(f"Command failed: {exc}", file=sys.stderr)
		return 1

	return 0


if __name__ == "__main__":
	print("\n\nMBDA Jetson Development Environment - Command Launcher\n\n")
	raise SystemExit(main())
