{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "Python: run_command --board jetson-orin-nano",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/run_command",
            "args": [
                "--board",
                "jetson-orin-nano"
            ],
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "console": "integratedTerminal"
        },
        {
            "name": "Python: run_command --board jetson-orin-nano --download jetpack-6.2.1",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/run_command",
            "args": [
                "--board",
                "jetson-orin-nano",
                "--download",
                "jetpack-6.2.1"
            ],
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "console": "integratedTerminal"
        },
        {
            "name": "Python: run_command --board jetson-orin-nano --download jetpack-7.2",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/run_command",
            "args": [
                "--board",
                "jetson-orin-nano",
                "--download",
                "jetpack-7.2"
            ],
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "console": "integratedTerminal"
        }
    ]
}